      BEGIN DSSUBRECORD
         Name "segment"
         SqlType "12"
         Precision "255"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "32"
         Derivation "If lnk_rfm.r_score >= 4 And lnk_rfm.f_score >= 4 Then \"CHAMPION\" Else If lnk_rfm.r_score >= 3 And lnk_rfm.f_score >= 3 Then \"LOYAL\" Else If lnk_rfm.r_score >= 4 Then \"RECENT\" Else If lnk_rfm.r_score <= 2 And lnk_rfm.f_score >= 3 Then \"AT_RISK\" Else \"HIBERNATING\""
         Group "0"
         ParsedDerivation "If lnk_rfm.r_score >= 4 And lnk_rfm.f_score >= 4 Then \"CHAMPION\" Else If lnk_rfm.r_score >= 3 And lnk_rfm.f_score >= 3 Then \"LOYAL\" Else If lnk_rfm.r_score >= 4 Then \"RECENT\" Else If lnk_rfm.r_score <= 2 And lnk_rfm.f_score >= 3 Then \"AT_RISK\" Else \"HIBERNATING\""
         SortKey "0"
         SortType "0"
         AllowCRLF "0"
         LevelNo "0"
         Occurs "0"
         PadNulls "0"
         SignOption "0"
         SortingOrder "0"
         ArrayHandling "0"
         SyncIndicator "0"
