      BEGIN DSSUBRECORD
         Name "r_score"
         SqlType "4"
         Precision "10"
         Scale "0"
         Nullable "0"
         KeyPosition "0"
         DisplaySize "10"
         Derivation "If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 30 Then 5 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 90 Then 4 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 180 Then 3 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 270 Then 2 Else 1"
         Group "0"
         ParsedDerivation "If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 30 Then 5 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 90 Then 4 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 180 Then 3 Else If DaysSinceFromDate(StringToDate(pRunDate, \"%yyyy-%mm-%dd\"), StringToDate(lnk_attrs.last_date_key, \"%yyyy%mm%dd\")) <= 270 Then 2 Else 1"
